# Bot WhatsApp CafeSite — placeholder environment variables.
# Salin file ini ke .env.local lalu isi nilai sungguhan. JANGAN commit .env.local.

# Nomor WhatsApp bot (format internasional tanpa +), contoh: 628123456789
WA_BOT_PHONE=628xxxxxxx

# --- AI Hub: panggil model Nemotron langsung ke NVIDIA API (bukan OpenRouter) ---
NVIDIA_API_KEY=nvapi-xxxx
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# --- RAG: dokumen cafe (PDF) disimpan di Supabase (Postgres + pgvector) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxx

# --- Order via WA: satu akun bot tetap di Supabase Auth (WhatsApp bukan user
# Supabase). Buat manual di dashboard Supabase Auth (email/password), lalu
# salin user_id-nya ke sini. Dipakai sebagai `actor` di RPC create_cafe_order.
WA_BOT_USER_ID=xxxx-uuid-xxxx

# --- Embedding untuk RAG: default pakai NVIDIA (satu ecosystem dengan chat),
# jadi EMBEDDING_API_KEY bisa diisi sama dengan NVIDIA_API_KEY di atas.
# EMBEDDING_BASE_URL dipisah dari base URL chat supaya gampang ganti provider
# lain (mis. OpenAI) tanpa ubah kode kalau suatu saat dibutuhkan.
# Dimensi native nemotron-3-embed-1b = 2048 (tidak mendukung reduced
# dimensions via API cloud) - tabel rag_documents.embedding wajib vector(2048).
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
EMBEDDING_API_KEY=nvapi-xxxx
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1/embeddings

# --- Opsional: path Chromium/Chrome kustom untuk Puppeteer ---
# Kosongkan untuk pakai Chromium bawaan Puppeteer (default saat dev di laptop).
# Isi ini saat pindah ke VPS yang sudah punya Chrome/Chromium terpasang sendiri,
# supaya tidak perlu download ulang binary Puppeteer di server.
# Contoh Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
# Contoh Linux (VPS): /usr/bin/chromium-browser
PUPPETEER_EXECUTABLE_PATH=

# --- Opsional: anti-spam (rate-limit per nomor WhatsApp) ---
# Default kalau dikosongkan: 5 pesan per 60000ms (1 menit). Lewat batas ini,
# bot diam total (tidak balas apa-apa) untuk nomor tsb sampai window reset -
# lihat komentar di src/queue/rateLimit.ts untuk alasan kenapa "diam" dipilih.
RATE_LIMIT_MAX_PER_MINUTE=5
RATE_LIMIT_WINDOW_MS=60000

# --- Opsional: level log minimum yang ditampilkan (info/warn/error) ---
# Default "info" (semua level tampil). Set "warn" di production kalau log
# baris info terlalu ramai untuk dipantau sehari-hari.
LOG_LEVEL=info
